# ==============================================================================
# APPLICATION
# ==============================================================================
# The environment (development | test | production)
NODE_ENV=development

# ==============================================================================
# API & WORKER
# ==============================================================================
API_PORT=3000
API_HOST=0.0.0.0
WORKER_PORT=3002

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
# Full connection URL for Prisma (replace credentials before use)
DATABASE_URL=postgresql://atlascloud_app:CHANGE_ME_APP_PASSWORD@localhost:5432/atlascloud?schema=public
# Admin connection URL for migrations (separate restricted role)
DATABASE_ADMIN_URL=postgresql://atlascloud_admin:CHANGE_ME_ADMIN_PASSWORD@localhost:5432/atlascloud?schema=public
# Direct connection (no pooling) — used for RLS transaction wrappers
DATABASE_DIRECT_URL=postgresql://atlascloud_app:CHANGE_ME_APP_PASSWORD@localhost:5432/atlascloud?schema=public

POSTGRES_DB=atlascloud
POSTGRES_USER=atlascloud_admin
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_APP_USER=atlascloud_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# ==============================================================================
# JWT / AUTH
# ==============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
# Cache TTL in seconds
REDIS_CACHE_TTL=300

# ==============================================================================
# RABBITMQ
# ==============================================================================
RABBITMQ_URL=amqp://atlascloud:CHANGE_ME_RABBIT_PASSWORD@localhost:5672
RABBITMQ_USER=atlascloud
RABBITMQ_PASSWORD=CHANGE_ME_RABBIT_PASSWORD
RABBITMQ_VHOST=/

# ==============================================================================
# OBSERVABILITY
# ==============================================================================
LOG_LEVEL=info
# Metrics endpoint auth token (protects /metrics from public access)
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# ==============================================================================
# SECURITY
# ==============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Request body size limit
REQUEST_BODY_LIMIT=10mb

# ==============================================================================
# PLATFORM ADMIN BOOTSTRAP
# ==============================================================================
# Used only for the initial admin seed — remove from production after use
PLATFORM_ADMIN_EMAIL=admin@atlascloud.local
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_BOOTSTRAP_PASSWORD
